# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; this file must never contain real secrets.

# AI provider API keys (set the one matching config.yaml's llm.provider /
# embedding.provider; both may be needed if providers differ per role)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Chat channel credentials (admin-managed; may also be entered via the console)
TELEGRAM_BOT_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Fernet key used to encrypt chat credentials at rest (app/db `integration`
# table). Required — startup fails if this is missing or invalid.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Password for the Streamlit admin console
ADMIN_PASSWORD=
