# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; this file must never contain real secrets.

# AI provider API keys. The shipped demo uses Anthropic for classification
# and generation, so set this key. Local embeddings need no key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is only needed if llm.provider or embedding.provider is
# switched to "openai".
OPENAI_API_KEY=

# Optional but recommended for authenticated Hugging Face model downloads.
# Create a read token at https://huggingface.co/settings/tokens.
HF_TOKEN=
# Xet provides visible, resumable model transfers. High-performance mode uses
# additional concurrency; disable it if the network administrator requires it.
HF_HUB_DISABLE_XET=
HF_XET_HIGH_PERFORMANCE=

# Telegram and Teams credentials are entered in the Frontend Integrations UI.
# They are encrypted in SQLite and are never stored here in plaintext.
# Optional corporate proxy. Use http:// for an HTTP proxy, or socks5h:// for
# SOCKS with remote DNS. Set ALL_PROXY, HTTPS_PROXY, and HTTP_PROXY consistently.
# ALL_PROXY=http://127.0.0.1:8118
# HTTPS_PROXY=http://127.0.0.1:8118
# HTTP_PROXY=http://127.0.0.1:8118
# Optional dedicated route for Telegram polling and delivery. This overrides
# generic proxy variables for Telegram only and is preserved across managed
# laptop-demo restarts.
# TELEGRAM_PROXY_URL=http://127.0.0.1:8118
# WHATSAPP_PROXY_URL=http://127.0.0.1:8118
# Encrypts admin-managed Telegram and Teams credentials at rest. The laptop
# helper generates this once when it is empty. Keep it private and back it up
# separately from data/intelliknow.db.
CREDENTIAL_ENCRYPTION_KEY=

# Password for the Streamlit admin console
ADMIN_PASSWORD=

# Laptop demo HTTPS is enabled by default. Run `./scripts/laptop-demo setup-https`
# once, or let `start` create the trusted localhost certificate automatically.
# Set this to 0 only when an HTTP-only demo is explicitly required.
INTELLIKNOW_HTTPS=
