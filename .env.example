# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; this file must never contain real secrets.

# AI provider API keys. The shipped config.yaml default (llm.provider: local,
# embedding.provider: local) talks to a local Ollama server and needs NEITHER
# key set — leave both blank for the zero-cost development path.
#
# To run the Anthropic demo path instead, set llm.provider: anthropic in
# config.yaml (see the comment above config.yaml's llm: block) and fill in:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is only needed if llm.provider or embedding.provider is
# switched to "openai".
OPENAI_API_KEY=

# Chat channel credentials (admin-managed; may also be entered via the console)
TELEGRAM_BOT_TOKEN=
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Fernet key used to encrypt chat credentials at rest in the `integrations`
# table. Required when starting the production API.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Password for the Streamlit admin console
ADMIN_PASSWORD=
