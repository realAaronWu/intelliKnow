# Copy this file to `.env` and fill in real values there.
# `.env` is gitignored; this file must never contain real secrets.

# AI provider API keys. The shipped demo uses Anthropic for classification
# and generation, so set this key. Local embeddings need no key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY is only needed if llm.provider or embedding.provider is
# switched to "openai".
OPENAI_API_KEY=

# Optional but recommended for authenticated Hugging Face model downloads.
# Create a read token at https://huggingface.co/settings/tokens.
HF_TOKEN=
# Xet provides visible, resumable model transfers. High-performance mode uses
# additional concurrency; disable it if the network administrator requires it.
HF_HUB_DISABLE_XET=
HF_XET_HIGH_PERFORMANCE=

# Chat channel credentials (admin-managed; may also be entered via the console)
TELEGRAM_BOT_TOKEN=
# Optional corporate proxy. Use http:// for an HTTP proxy, or socks5h:// for
# SOCKS with remote DNS. Set ALL_PROXY, HTTPS_PROXY, and HTTP_PROXY consistently.
# ALL_PROXY=http://127.0.0.1:8118
# HTTPS_PROXY=http://127.0.0.1:8118
# HTTP_PROXY=http://127.0.0.1:8118
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=

# Fernet key used to encrypt chat credentials at rest in the `integrations`
# table. Required when starting the production API.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Password for the Streamlit admin console
ADMIN_PASSWORD=
